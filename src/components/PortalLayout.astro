---
import Header from './Header.astro';
import Footer from './Footer.astro';
import CloudflareBeacon from './CloudflareBeacon.astro';
import { getEntry, getCollection } from 'astro:content';
import { timestamp } from '../utils/date';
import { permalinkOf } from '../utils/postOrder';
import { getUiLabels } from '../utils/uiLabels';
import config from '../content/config/config.json';
import '../styles/global.css';

interface FusumaImage {
  image?: string;
}

interface FusumaText {
  title?: string;
  subtitle?: string;
}

interface Props {
  title?: string;
  hero?: {
    fusumaImages?: FusumaImage[];
    fusumaTexts?: FusumaText[];
    title?: string;
    subtitle?: string;
  };
}

const { title, hero } = Astro.props;

// UI ラベル（Keystatic「UI ラベル」で編集可能）
const L = (await getUiLabels()).portal;

// サイト共通設定（Keystatic「サイト共通」で編集可能）
const globalConfig = await getEntry('global', 'config');
const siteTitle = globalConfig?.data?.siteTitle || '間　MA (Vide Signifiant)';
const seoTitle = config.seo?.title || siteTitle;

// "Latest Writing" は Blog の最新記事へ解決する。
const allPosts = await getCollection('blog');
const latestUrl = (() => {
  const sorted = [...allPosts].sort(
    (a, b) =>
      timestamp(b.data.updatedDate, b.data.pubDate) -
      timestamp(a.data.updatedDate, a.data.pubDate),
  );
  return sorted[0] ? `/blog/${permalinkOf(sorted[0].id)}` : '/';
})();

// FUSUMA は画像とテキストを分けて管理する。どちらも最大5件。
// 画像とテキストは同じ添字で対になり、1 → 5 → 1 のサイクルで巡回する。
const MAX_FUSUMA = 5;

const imageEntries = (hero?.fusumaImages ?? [])
  .map((s) => s?.image)
  .filter((src): src is string => Boolean(src))
  .slice(0, MAX_FUSUMA);

const textEntries = (hero?.fusumaTexts ?? []).slice(0, MAX_FUSUMA);

// 画像とテキストを添字で揃える。画像が無い添字はテキストだけ単独で使う。
const cycleSize = Math.max(imageEntries.length, textEntries.length);

const slides = Array.from({ length: cycleSize }, (_, i) => ({
  src: imageEntries[i] ?? '',
  title: textEntries[i]?.title ?? '',
  subtitle: textEntries[i]?.subtitle ?? '',
  alt: textEntries[i]?.title || `FUSUMA ${i + 1}`,
})).filter((s) => s.src || s.title);

const firstSlide = slides[0];
const slideCount = slides.length;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>{title || seoTitle}</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;1,400&family=Noto+Serif+JP:wght@400;700&family=Manrope:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0" rel="stylesheet"/>
  {firstSlide && (
    <link rel="preload" as="image" href={firstSlide.src} />
  )}
</head>
<body class="min-h-screen bg-[#F8F5F2] font-serif text-gray-700 selection:bg-[#8B593E]/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Header />
    <a href="#main-content" class="sr-only sr-only-focusable">{L.skipCarousel}</a>
    
    <main id="main-content" class="py-8 sm:py-12 md:py-16">
      <div class="flex flex-col w-full">
      <section id="hero-container" role="region" aria-roledescription="carousel" aria-label="Portal hero" class="relative w-full max-w-[1200px] mx-auto aspect-[3/2] bg-[#070714] rounded-sm overflow-hidden shadow-2xl flex items-center justify-center select-none" data-slide-count={slideCount} data-slides-json={JSON.stringify(slides.map((s) => ({ title: s.title || '', subtitle: s.subtitle || '' })))}>
        <div id="fusuma-wrapper" class="absolute inset-0 z-40 pointer-events-none transition-all duration-1000">
          <div id="fusuma-left-door" class="fusuma-panel fusuma-left">
            <div class="fusuma-handle-left"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-black/5 via-transparent to-black/10"></div>
          </div>
          <div id="fusuma-right-door" class="fusuma-panel fusuma-right">
            <div class="fusuma-handle-right"></div>
            <div class="absolute inset-0 bg-gradient-to-l from-black/5 via-transparent to-black/10"></div>
          </div>
        </div>

        <div class="absolute inset-0 w-full h-full z-10 overflow-hidden">
          {slides.map((slide, idx) =>
            slide.src ? (
              <div
                class={`hero-slide absolute inset-0 bg-cover bg-center${idx === 0 ? ' active' : ''}`}
                style={`background-image: url("${slide.src}");`}
                title={slide.alt}
                data-slide={idx}
              >
                <div class="absolute inset-0 bg-black/35"></div>
              </div>
            ) : null,
          )}
        </div>

        <div class="absolute inset-0 z-20 pointer-events-none bg-gradient-to-t from-[#070714] via-transparent to-[#070714]/40 mix-blend-multiply"></div>

        <div id="hero-text-block" class="hero-text-block active absolute inset-0 z-30 flex flex-col items-center justify-center text-center p-6 sm:p-12 pointer-events-none">
          <div class="relative flex flex-col items-center max-w-3xl px-4">
            <h2 id="hero-slide-title" class="relative text-3xl sm:text-4xl md:text-6xl font-bold mb-4 text-white font-serif tracking-tight drop-shadow-xl hero-title leading-tight">{firstSlide?.title}</h2>
            <p id="hero-slide-subtitle" class="relative text-lg md:text-xl max-w-2xl mx-auto text-[#f0edea] italic font-serif leading-relaxed drop-shadow-md hero-subtitle">{firstSlide?.subtitle}</p>
          </div>
        </div>

        <button type="button" id="ma-trigger-btn" class="group cursor-pointer select-none z-30" title="Replay Fusuma Cycle">
          <span class="text-xl font-bold text-white tracking-widest group-hover:text-[#fcb797] transition-colors leading-none font-serif">間</span>
          <span class="text-[10px] font-extrabold uppercase tracking-[0.25em] text-[#c89b7b] mt-1 group-hover:text-white transition-colors font-serif">{L.videSignifiant}</span>
          <span class="material-symbols-outlined text-[10px] text-[#c89b7b]/70 group-hover:text-[#c89b7b] transition-colors mt-0.5 animate-bounce">unfold_more</span>
        </button>
      </section>

      <script src="/scripts/fusuma-hero.js" defer></script>

      <slot />
      </div>
    </main>

    <Footer />
  </div>
  <CloudflareBeacon />
</body>
</html>