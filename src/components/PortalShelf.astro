---
// Volume I Bundle — /tmp/ma-portal/src/App.tsx L242-372 100% 準拠
// 既存テキスト/画像は変更しない。props の blog エントリをそのまま写すだけ。
import { getUiLabels } from '../utils/uiLabels';

interface BundleItem {
  id?: string;
  title?: string;
  description?: string;
  heroImage?: string;
  href?: string;
}

interface Props {
  bundle?: BundleItem[];
}

const { bundle = [] } = Astro.props as Props;

// UI ラベル（Keystatic「UI ラベル」で編集可能）
const L = (await getUiLabels()).portal;

const items = (Array.isArray(bundle) ? bundle : []).filter(Boolean).slice(0, 2);
---

{items.length > 0 && (
  <section class="w-full max-w-[1200px] mx-auto px-4 mb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {items.map((item, idx) => (
        <article class="group relative bg-white rounded-lg overflow-hidden shadow-xs hover:shadow-lg transition-all duration-300 border border-gray-100 flex flex-col h-[420px] cursor-pointer">
          <a href={item.href} class="block">
            <div class="w-full h-72 sm:h-80 overflow-hidden shrink-0 bg-gray-100 relative">
              {item.heroImage && (
                <img
                  src={item.heroImage}
                  alt={item.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              )}
            </div>
            <div class="p-6 bg-white flex flex-col justify-center grow border-t border-gray-100">
              <div class="text-xs font-bold text-[#A36A4F] mb-1 uppercase tracking-wider">{L.pageCategory}</div>
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-[#A36A4F] transition-colors leading-snug font-serif">
                {item.title}
              </h3>
            </div>
            <div class="absolute inset-0 bg-[#faf8f5]/95 backdrop-blur-xs p-6 sm:p-8 flex flex-col justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20 pointer-events-none group-hover:pointer-events-auto">
              <div>
                <div class="text-xs font-bold text-[#A36A4F] uppercase tracking-wider mb-2">
                  {L.bundleEpisodeLabel} {idx + 1}
                </div>
                <h4 class="text-lg sm:text-xl font-bold text-gray-900 font-serif leading-snug mb-3">
                  {item.title}
                </h4>
                {item.description && (
                  <p class="text-gray-700 text-xs sm:text-sm leading-relaxed whitespace-pre-line text-justify font-serif">
                    {item.description}
                  </p>
                )}
              </div>
              <div class="pt-4 border-t border-gray-200 flex items-center justify-between mt-auto">
                <span class="inline-flex items-center text-[#A36A4F] hover:text-[#8B593E] font-medium text-sm transition-colors">
                  <span>{L.readMoreLabel}</span>
                  <span class="material-icons-outlined text-sm ml-1">arrow_forward</span>
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
)}
