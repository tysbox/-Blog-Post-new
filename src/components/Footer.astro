---
import { getEntry } from 'astro:content';
import siteSettings from '../content/settings/site.json';

const globalConfig = await getEntry('global', 'config');
const { footerText, socialLinks } = globalConfig?.data || { footerText: '© 2025 The Way of Aesthetics. All rights reserved.', socialLinks: [] };
const footerConfig = siteSettings?.footer || {};
const links = footerConfig.links || socialLinks || [];
// Prefer the canonical site title (header) for the footer logo/text
const logo = globalConfig?.data?.siteTitle || footerConfig.logo || 'Wabi-Sabi Blog';
const today = new Date();
---
	<footer class="site-footer">
	  <div class="footer-content">
	    <div class="footer-left">
	      <div class="footer-logo">{logo}</div>
	      <div class="footer-copy">{footerText}</div>
	    </div>
	    <div class="footer-right">
	      <nav class="footer-links">
	        {links?.map((l) => (
	          <a href={l.url || l.href} target="_blank" rel="noopener noreferrer">{l.label || l.platform}</a>
	        ))}
	      </nav>
	    </div>
	  </div>
	</footer>

<style>

	.site-footer {
	  padding: 2rem 1rem;
	  background: linear-gradient(var(--gray-gradient)) no-repeat;
	  color: rgb(var(--gray));
	}

	.footer-content {
	  max-width: 80rem;
	  margin: 0 auto;
	  display: flex;
	  justify-content: space-between;
	  align-items: center;
	  gap: 1rem;
	}

	.footer-left { display:flex; flex-direction:column; gap:0.5rem; }
	.footer-logo { font-weight: 700; color: rgb(var(--black)); font-size: 0.95rem; line-height: 1; }
	.footer-copy { color: rgb(var(--gray)); font-size: 0.95rem; }

	.footer-links { display:flex; gap:1rem; }
	.footer-links a { color: rgb(var(--gray)); text-decoration:none; }
	.footer-links a:hover { color: rgb(var(--gray-dark)); }

	@media (max-width: 640px) {
	  .footer-content { flex-direction: column; align-items: center; text-align: center; }
	}

</style>
