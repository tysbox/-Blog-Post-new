---
import { getEntry, getCollection } from 'astro:content';
import config from '../content/config/config.json';
import { timestamp } from '../utils/date';
import { permalinkOf } from '../utils/postOrder';

// 新ポータル準拠: Home / Latest Writing(最新記事へ) / About & Contact + BiScèneロゴ
// 既存テキスト・画像の書き換えなし。リンク先のみ既存データから解決する。
// ナビの文言と URL は Keystatic「SEO / ナビゲーション設定」navLinks から読む。
const globalConfig = await getEntry('global', 'config');
const { siteTitle, lpLogo, lpUrl } = globalConfig?.data || { siteTitle: '間　MA (Vide Signifiant)', lpLogo: null, lpUrl: null };

const navLinks = (config?.navLinks ?? []).filter((l) => l?.label && l?.href);

let lpLogoSrc: string | null = null;
if (lpLogo) {
  if (typeof lpLogo === 'string') {
    lpLogoSrc = lpLogo;
  } else if (typeof lpLogo === 'object') {
    const o = lpLogo as Record<string, unknown>;
    const v = o.src || o.value || o.path || o.filename;
    if (typeof v === 'string') lpLogoSrc = v;
  }
  if (lpLogoSrc && !lpLogoSrc.match(/^https?:\/\//)) {
    lpLogoSrc = lpLogoSrc.startsWith('/') ? lpLogoSrc : `/${lpLogoSrc}`;
  }
}

const allPosts = await getCollection('blog');
const sortedContent = allPosts
  .map((post) => ({
    date: timestamp(post.data.updatedDate, post.data.pubDate),
    href: `/blog/${permalinkOf(post.id)}`,
  }))
  .sort((a, b) => b.date - a.date);
const latestContentUrl = sortedContent[0] ? sortedContent[0].href : '/';

// /latest は「最新の記事」そのものを指すため、実際のURLに解決する。
const resolveHref = (href: string) => (href === '/latest' ? latestContentUrl : href);
---
<header class="flex justify-between items-center py-6 border-b border-gray-200">
  <div class="flex items-center gap-6">
    <h1 class="text-2xl font-bold text-gray-900">
      <a href="/" class="hover:text-[#A36A4F] transition-colors">{siteTitle || '間　MA (Vide Signifiant)'}</a>
    </h1>
  </div>
  <nav class="hidden md:flex items-center space-x-8 text-sm font-medium">
    {navLinks.map((link: any, i: number) => (
      <a
        href={resolveHref(link.href)}
        class={i === 0 ? 'text-[#A36A4F] font-semibold transition-colors' : 'text-gray-600 hover:text-[#A36A4F] transition-colors'}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <div class="flex items-center space-x-4">
    {lpLogoSrc ? (
      <a
        href={lpUrl || 'https://bisen-kyoto.com/'}
        target="_blank"
        rel="noopener noreferrer"
        class="block w-[95px] sm:w-[105px] h-[50px] sm:h-[60px] flex items-center justify-center transition-transform hover:scale-105"
      >
        <img src={lpLogoSrc} alt="BiScène" class="w-[95px] sm:w-[105px] h-[50px] sm:h-[60px] object-contain" width="105" height="60" />
      </a>
    ) : (
      <a
        href="https://bisen-kyoto.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-[95px] sm:w-[105px] h-[50px] sm:h-[60px] flex items-center justify-center transition-transform hover:scale-105"
      >
        <img src="/images/Logo1.png" alt="BiScène" class="w-[95px] sm:w-[105px] h-[50px] sm:h-[60px] object-contain" width="105" height="60" />
      </a>
    )}
  </div>
</header>

