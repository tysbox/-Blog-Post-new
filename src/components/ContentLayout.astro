---
import JapaneseAccordion from './react/JapaneseAccordion';
import { richTextToHtml } from '../utils/richText';

interface Props {
  hero: {
    image1?: string;
    title?: string;
    subtitle?: string;
  };
  japaneseText?: any;
  contentSections?: Array<{
    _template: 'textBlock' | 'imageGrid';
    bodyText?: string;
    images?: Array<{
      src: string;
      label?: string;
      caption?: string;
    }>;
  }>;
}

const { hero = {}, contentSections, japaneseText } = Astro.props;
---

<div class="relative w-full">
  {hero?.image1 && (
    <img alt={hero.title || 'Hero Image'} class="w-full h-[66vh] object-cover" src={hero.image1}/>
  )}
  <div class="absolute inset-0 bg-black bg-opacity-10"></div>
  <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
    <div class="w-4/5 -translate-y-12">
      <h1 class="text-white text-[calc((1rem+4vw)*0.7)] leading-tight font-medium">{hero?.title}</h1>
      <p class="text-white text-lg mt-2">{hero?.subtitle}</p>
    </div>
  </div>
</div>

{japaneseText && (
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
    <JapaneseAccordion content={japaneseText} client:load />
  </div>
)}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
  {contentSections?.map((section) => {
    if (section._template === 'textBlock') {
      return (
        <div class="text-gray-700 text-base font-normal leading-relaxed space-y-4">
          {section.bodyText && (
            <div class="prose max-w-none" set:html={richTextToHtml(section.bodyText)} />
          )}
        </div>
      );
    }
    
    if (section._template === 'imageGrid') {
      const images = section.images || [];
      const isSingle = images.length === 1;

      if (isSingle) {
        const img = images[0];
        return (
          <div class="flex justify-center w-full">
            <div class="flex flex-col gap-2 w-full md:w-3/4">
              <img 
                alt={img.label || 'Content Image'} 
                class="w-full aspect-[3/2] object-cover rounded-lg shadow-sm" 
                src={img.src}
              />
              {(img.label || img.caption) && (
                <div class="text-sm text-gray-500 text-center">
                  {img.label && <span class="font-bold block">{img.label}</span>}
                  {img.caption && <span>{img.caption}</span>}
                </div>
              )}
            </div>
          </div>
        );
      }
      
      return (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {images.map((img) => (
            <div class="flex flex-col gap-2">
              <img 
                alt={img.label || 'Content Image'} 
                class="w-full aspect-square object-cover rounded-lg" 
                src={img.src}
              />
              {(img.label || img.caption) && (
                <div class="text-sm text-gray-500">
                  {img.label && <span class="font-bold block">{img.label}</span>}
                  {img.caption && <span>{img.caption}</span>}
                </div>
              )}
            </div>
          ))}
        </div>
      );
    }
    return null;
  })}
</div>