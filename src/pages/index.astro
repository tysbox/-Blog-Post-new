---
import PortalLayout from '../components/PortalLayout.astro';
import { getCollection, getEntry, getEntries, render } from 'astro:content';

const homePage = await getEntry('portal', 'home');
const { Content } = await render(homePage);
const pageData = homePage?.data || {};


// Get latest blog posts
const allPosts = await getCollection('blog');

// Normalize data for sorting
const combinedContent = allPosts.map(post => ({
  ...post,
  date: new Date(post.data.updatedDate || post.data.pubDate).valueOf(),
  title: post.data.title,
  description: post.data.description,
  heroImage: post.data.heroImage,
  href: `/blog/${post.id}`
}));

// Get manually featured items if any
let manualContent = [];
if (pageData.featuredItems && pageData.featuredItems.length > 0) {
  const references = pageData.featuredItems.map(wrapper => {
    const item = wrapper?.item;
    if (!item) return null;

    // If the stored item is a string path (legacy format)
    if (typeof item === 'string') {
      // 正本は blog のみ。旧パス src/content/pages/*.json は廃止した
      // `page` コレクションの storage だが、既存データにはその形式が
      // 残っているので basename を id に正規化し blog として解決する。
      const match = item.match(/^src\/content\/(?:blog|pages)\/([^.]+)\.(?:mdx|md|json)$/);
      return match ? { collection: 'blog', id: match[1] } : null;
    }

    // If the stored item is a Tina reference object
    if (typeof item === 'object') {
      const id = item.id || item?.value || item?.sys?.filename || item?.sys?.relativePath;
      if (!id) return null;
      // 正本は blog のみ。collection 名は気にせず id だけで解決する。
      return { collection: 'blog', id: id.replace(/\.(mdx|md|json)$/, '') };
    }

    return null;
  }).filter(ref => ref !== null);

  const featuredEntries = await getEntries(references);
  const validFeaturedEntries = (featuredEntries || []).filter(Boolean);
  manualContent = validFeaturedEntries.map(entry => {
    if (!entry) return null;
    return {
      ...entry,
      date: new Date(entry.data.updatedDate || entry.data.pubDate).valueOf(),
      title: entry.data.title,
      description: entry.data.description,
      heroImage: entry.data.heroImage,
      href: `/blog/${entry.id}`
    };
  }).filter(Boolean);
}

// Sort automatic content by date
const sortedAutomaticContent = combinedContent.sort((a, b) => b.date - a.date);

// Filter out manually selected items from automatic list to avoid duplicates
const manualIds = new Set(manualContent.map(item => item.id));
const filteredAutomaticContent = sortedAutomaticContent.filter(item => !manualIds.has(item.id));

// Combine: Manual items first, then automatic items
const finalContent = [...manualContent, ...filteredAutomaticContent];

const displayCount = Number(pageData.displayCount) > 0 ? Math.floor(Number(pageData.displayCount)) : 5;
const latestContent = finalContent.slice(0, displayCount);
const featuredContent = latestContent[0];
const otherContent = latestContent.slice(1);
---

<PortalLayout title={pageData.seoTitle || 'Hidden Treasure Kyoto Blog – Reflections on Japanese Culture, Shinto and Aesthetics'} hero={pageData.hero}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Intro Section */}
    <div id="latest" class="text-center mb-16 scroll-mt-24">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8">
        {pageData.introTitle || 'Recent Writings'}
      </h2>
      {pageData.introText && (
        <div class="max-w-4xl mx-auto text-lg text-gray-600 leading-relaxed whitespace-pre-line">
          {pageData.introText}
        </div>
      )}
    </div>
    
    {/* Featured Post */}
    {featuredContent && (
      <article class="bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-100 mb-12">
        <div class="md:flex">
          {featuredContent.heroImage && (
            <div class="md:w-1/2">
              <a href={featuredContent.href} class="block h-96 md:h-[600px] overflow-hidden">
                <img 
                  src={featuredContent.heroImage} 
                  alt={featuredContent.title}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                />
              </a>
            </div>
          )}
          <div class="p-8 md:p-12 md:w-1/2 flex flex-col justify-center">
            <div class="text-xs font-bold text-[#A36A4F] mb-3 uppercase tracking-wider">
              Featured Blog Post
            </div>
            <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
              <a href={featuredContent.href} class="hover:text-[#A36A4F] transition-colors">
                {featuredContent.title}
              </a>
            </h3>
            <p class="text-gray-600 text-base mb-6 line-clamp-3">
              {featuredContent.description}
            </p>
            <a href={featuredContent.href} class="inline-flex items-center text-[#A36A4F] hover:text-[#8B593E] font-medium transition-colors">
              Read More <span class="material-icons-outlined text-sm ml-1">arrow_forward</span>
            </a>
          </div>
        </div>
      </article>
    )}

    {/* Other Posts Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {otherContent.map((item) => (
        <article class="bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-100 flex flex-col h-full">
          {item.heroImage && (
            <a href={item.href} class="block h-80 overflow-hidden flex-shrink-0">
              <img 
                src={item.heroImage} 
                alt={item.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              />
            </a>
          )}
          <div class="p-6 flex flex-col flex-grow">
            <div class="text-xs font-bold text-[#A36A4F] mb-2 uppercase tracking-wider">
              Blog Post
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">
              <a href={item.href} class="hover:text-[#A36A4F] transition-colors">
                {item.title}
              </a>
            </h3>
            <p class="text-gray-600 text-sm mb-4 line-clamp-3 flex-grow">
              {item.description}
            </p>
            <a href={item.href} class="inline-flex items-center text-[#A36A4F] hover:text-[#8B593E] font-medium text-sm transition-colors mt-auto">
              Read More <span class="material-icons-outlined text-sm ml-1">arrow_forward</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</PortalLayout>
