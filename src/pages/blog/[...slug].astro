---
// 記事ページ — /tmp/mablogx/src/App.tsx 100% 準拠
// 既存テキスト/画像は変更しない（frontmatter と contentSections をそのまま使う）。
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import ImageGrid from '../../components/mdx/ImageGrid.astro';
import KarutaGrid from '../../components/mdx/KarutaGrid.astro';
import { richTextToHtml, stripMarkdown } from '../../utils/richText';
import { extractToc, addHeadingIds } from '../../utils/toc';
import { orderPosts, permalinkOf } from '../../utils/postOrder';
import { timestamp } from '../../utils/date';
import { getUiLabels } from '../../utils/uiLabels';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  // 前後の記事ナビは【日付ではなく Index（章順）】に従う。
  // Index と同じ並び = src/utils/postOrder.ts（order 値 → 無ければ公開日の昇順）。
  const ordered = orderPosts(posts).map((o) => o.post);

  return posts.map((post) => {
    const index = ordered.findIndex((p) => p.id === post.id);
    const before = index > 0 ? ordered[index - 1] : null; // 1 つ前の記事
    const after = index >= 0 && index < ordered.length - 1 ? ordered[index + 1] : null; // 1 つ後の記事
    const toNav = (entry: any) =>
      entry
        ? { id: entry.id, title: stripMarkdown(entry.data.title), href: `/blog/${permalinkOf(entry.id)}` }
        : null;

    return {
      // URL は日付接頭辞なしの従来スラグ（ファイル名だけ日付付きにしている）
      params: { slug: permalinkOf(post.id) },
      props: { post, prev: toNav(before), next: toNav(after) },
    };
  });
}

const { post, prev, next } = Astro.props as any;

// UI ラベル（Keystatic「UI ラベル」で編集可能）
const L = (await getUiLabels()).article;

const {
  title,
  description,
  pubDate,
  heroImage,
  heroTitle,
  heroSubtitle,
  contentSections = [],
} = post.data;

const headingPlain = stripMarkdown(heroTitle || title);
const subtitlePlain = stripMarkdown(heroSubtitle || description);

// Overline 用の日本語タイトル: japaneseText の先頭見出しから抽出する。
// h1（headingPlain）と重複させないため、既存本文を書き換えず表示のみ差し替える。
const headingJp = (() => {
  const raw = post.data.japaneseText;
  const text = typeof raw === 'string' ? raw : '';
  if (!text) return '';
  const m = text.match(/^###?\s*\*\*(.+?)\*\*/m) || text.match(/^###?\s*(.+)$/m);
  return m ? stripMarkdown(m[1]) : '';
})();

// 日本語原文の HTML。
// 旧 JapaneseAccordion コンポーネントと同じく Markdown を解釈する（生の `###` / `**` が
// 文字として出るのを防ぐ）。加えて Keystatic は複数行を YAML の folded scalar（>）で
// 保存するため日本語の文中に「折り返し→空白」が混入するので、日本語文字間の空白のみ除去する。
const japaneseHtml = (() => {
  const raw = post.data.japaneseText;
  if (typeof raw !== 'string' || !raw.trim()) return '';
  const normalized = raw
    .replace(/([぀-ヿ㐀-䶿一-鿿])[ \t]+(?=[぀-ヿ㐀-䶿一-鿿])/g, '$1')
    .trim();
  return richTextToHtml(normalized);
})();

// Index は textBlock の見出しから自動生成（既存本文の書き換えなし）。
const tocEntries = extractToc(contentSections);

// 記事固有のカルタブロック（Keystatic contentSections の karutaGrid）。
// 入力があればそれを優先し、無ければ KarutaGrid 側で全記事共通の karuta.json を使う。
const karutaSection = (contentSections || []).find(
  (s: any) => s?._template === 'karutaGrid',
);
const karutaTitle = karutaSection?.karutaTitle || '';
const karutaCards = Array.isArray(karutaSection?.karutaCards)
  ? karutaSection.karutaCards
  : [];
// カルタは記事固有データ or 全記事共通データのいずれかで必ず出力される。
const hasKaruta = true;

// Index のアンカーと本文見出し id を対応させる
const tocIdsBySection = new Map<number, string[]>();
tocEntries.forEach((entry) => {
  const list = tocIdsBySection.get(entry.sectionIndex) ?? [];
  list.push(entry.id);
  tocIdsBySection.set(entry.sectionIndex, list);
});

// 読了時間（本文の文字数ベース）
const readMinutes = (() => {
  const all = (contentSections || [])
    .map((s: any) => (typeof s?.bodyText === 'string' ? s.bodyText : ''))
    .join(' ');
  const chars = all.replace(/\s+/g, '').length;
  return Math.max(1, Math.round(chars / 700));
})();

// Index（目次）: 表示順（order → 無ければ公開日の昇順）に沿って全記事を列挙する。
// 記事数が増えてもドロワーが溢れないよう、既定は「現在位置の前後5件」のみ表示し、
// 「すべて表示」で全件をスクロールさせる（50記事でも破綻しない設計）。
const INDEX_WINDOW = 5;
const allPosts = orderPosts(await getCollection('blog'));
const currentIndex = Math.max(
  0,
  allPosts.findIndex((o) => o.post.id === post.id),
);

const indexArticles = allPosts.map(({ post: p, numberText }) => ({
  id: p.id,
  href: `/blog/${permalinkOf(p.id)}`,
  number: numberText,
  // Index は目次なので記事の正式タイトル（title）を使う。heroTitle はヒーロー用見出しのため使わない。
  title: stripMarkdown(p.data.title || p.data.heroTitle),
  date: p.data.pubDate
    ? new Date(p.data.pubDate).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: '2-digit',
      }).toUpperCase()
    : '',
  isCurrent: p.id === post.id,
}));

// Index トリガーのラベル（全記事数を表す）
const indexRange = `${L.tocAllArticles} · ${indexArticles.length}`;

// 読了時間（本文の文字数ベース）
---

<BlogPost title={headingPlain} description={description}>
  {/* Article Header Meta & Main Title — App.tsx L158-225 */}
  <section class="max-w-4xl mx-auto w-full px-6 md:px-12 lg:px-0 pt-8 pb-6">
    <div class="flex flex-col space-y-3">
      <div class="flex flex-wrap items-center gap-2 text-xs font-sans tracking-widest text-[#865138] uppercase">
        <span class="bg-[#f0edea] px-2.5 py-1 font-semibold text-[#6f4229]">{L.categoryBadge}</span>
        <span class="text-[#d6c3ba]">•</span>
        <span class="text-[#51443d]">{pubDate ? new Date(pubDate).getFullYear() : ''}</span>
        <span class="text-[#d6c3ba]">•</span>
        <span class="text-[#51443d]">{readMinutes} {L.readSuffix}</span>
      </div>

      <div class="pt-2">
        {headingJp && (
          <span class="font-sans text-xs uppercase tracking-[0.25em] text-[#6f4229] font-medium block mb-2">
            {headingJp}
          </span>
        )}
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#1b1c1a] font-normal tracking-tight leading-[1.15]">
          {headingPlain}
        </h1>
        {subtitlePlain && (
          <p class="font-serif text-lg md:text-xl text-[#51443d] italic font-light pt-3 leading-relaxed whitespace-pre-line">
            {subtitlePlain}
          </p>
        )}
      </div>

      <div class="flex items-center justify-between pt-6 border-t border-[#d6c3ba]/30 mt-4 text-[#51443d]">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-[#eae8e4] flex items-center justify-center font-serif text-lg text-[#1b1c1a]">間</div>
          <div class="flex flex-col">
            <span class="font-sans text-xs font-semibold text-[#1b1c1a] tracking-wide">{L.editorialName}</span>
            <span class="font-sans text-[11px] text-[#51443d]">{L.editorialByline}</span>
          </div>
        </div>
        <div class="flex items-center space-x-3 text-xs font-sans tracking-widest">
          <span class="uppercase hidden sm:inline">
            {pubDate ? new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) : ''}
          </span>
          <button type="button" data-bookmark class="p-2 hover:text-[#6f4229] transition-colors text-[#51443d]" title="Bookmark">
            <span class="material-symbols-outlined text-[20px]">bookmark_border</span>
          </button>
          <button type="button" data-share class="p-2 hover:text-[#6f4229] transition-colors text-[#51443d]" title="Share">
            <span class="material-symbols-outlined text-[20px]">share</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  {/* Hero Image Showcase — App.tsx L228-262 */}
  {heroImage && (
    <section class="max-w-4xl mx-auto w-full px-6 md:px-12 lg:px-0">
      <div class="w-full relative bg-[#f6f3f0] overflow-hidden">
        <div class="w-full h-[360px] sm:h-[480px] md:h-[520px] overflow-hidden">
          <img src={heroImage} alt={headingPlain || 'Hero image'} class="w-full h-full object-cover" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
      </div>
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between py-2.5 text-xs text-[#51443d] font-sans gap-1 border-b border-[#d6c3ba]/30">
        <div class="flex items-center space-x-2">
          <span class="w-1.5 h-1.5 bg-[#6f4229] rounded-full shrink-0"></span>
          <span class="tracking-wide">{headingPlain}</span>
        </div>
        <span class="text-[11px] tracking-widest uppercase text-[#84746c] shrink-0">{L.figLabel}</span>
      </div>
    </section>
  )}

  {/* Interactive Trigger Bar — App.tsx L265-327 */}
  <section id="toc-container" class="max-w-4xl mx-auto w-full px-6 md:px-12 lg:px-0 relative my-6">
    <div class="w-full bg-[#f6f3f0] flex flex-col sm:flex-row items-stretch sm:items-center justify-between p-2 shadow-sm gap-2 border border-[#d6c3ba]/40">
      <button
        type="button"
        id="toc-trigger-btn"
        class="flex items-center space-x-3 px-4 py-2.5 bg-[#fcf9f5] text-[#1b1c1a] hover:bg-[#f0edea] transition-colors text-left group"
      >
        <span class="material-symbols-outlined text-[18px] text-[#6f4229] transition-transform group-hover:scale-110">menu</span>
        <span class="font-sans text-xs uppercase tracking-widest font-semibold">{L.indexLabel}</span>
        <span class="font-sans text-xs text-[#51443d] font-normal">({indexRange})</span>
      </button>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="lang-trigger-btn"
          class="flex items-center justify-between space-x-3 px-4 py-2.5 bg-[#fcf9f5] text-[#51443d] hover:text-[#1b1c1a] hover:bg-[#f0edea] transition-colors"
        >
          <div class="flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full bg-[#865138]"></span>
            <span class="font-sans text-xs uppercase tracking-wider font-semibold text-[#865138]">
              {L.japaneseToggle}
            </span>
          </div>
          <span id="lang-chevron" class="material-symbols-outlined text-[18px] transition-transform duration-300">expand_more</span>
        </button>
      </div>
    </div>

    {/* Accordion Drawer: Japanese Original Script — App.tsx L330-358 */}
    <div id="lang-drawer" class="hidden w-full bg-[#f0edea] p-6 mt-2 shadow-md border border-[#d6c3ba]/60 animate-fade-in">
      <div class="flex items-baseline justify-between mb-3 border-b border-[#d6c3ba]/40 pb-2">
        <span class="font-sans text-xs uppercase tracking-widest font-semibold text-[#865138]">{L.japaneseDrawerTitle}</span>
        <span class="font-sans text-xs text-[#51443d]">{L.japaneseDrawerByline}</span>
      </div>
      {/* 日本語原文: Index などのラベルと同じ茶色（#6f4229）。#865138 より1段濃い。 */}
      {japaneseHtml ? (
        <div
          class="font-serif text-sm sm:text-base text-[#6f4229] leading-relaxed mb-4 font-light bear-prose"
          set:html={japaneseHtml}
        />
      ) : (
        <p class="font-serif text-sm text-[#865138] mb-4">
          {L.japaneseEmpty}
        </p>
      )}
    </div>

    {/* Frosted Glass TOC Drawer — 透過75%(不透明度25%) / 幅500px / App.tsx L362-369 */}
    <div
      id="toc-drawer"
      class="hidden absolute top-full left-0 z-30 w-full sm:w-[500px] shadow-[0_16px_40px_rgba(0,0,0,0.12)] mt-2 p-6 animate-fade-in border border-[#8b593e]/30 select-text"
      style="background-color: rgba(252, 249, 245, 0.25); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);"
    >
      <div class="flex items-center justify-between pb-3 border-b border-[#8b593e]/20 mb-4">
        <span class="font-serif font-semibold text-lg text-[#1b1c1a] tracking-wide">{L.tocTitle}</span>
        <button type="button" id="toc-close-btn" class="p-1 text-[#51443d] hover:text-[#1b1c1a] transition-colors" aria-label="Close Table of Contents">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>

      <div class="mb-4">
        <div class="flex items-baseline justify-between gap-3 mb-2">
          <div class="text-[10px] font-sans uppercase tracking-[0.2em] text-[#6f4229] font-bold">
            {L.tocAllArticles}（{indexArticles.length}）
          </div>
          {indexArticles.length > INDEX_WINDOW * 2 + 1 && (
            <button
              type="button"
              id="toc-mode-btn"
              data-toc-mode-label
              data-full-label={`すべて表示（${indexArticles.length}）`}
              data-window-label="前後のみ"
              class="text-[10px] font-sans uppercase tracking-[0.15em] text-[#8b593e] font-semibold hover:text-[#6f4229] transition-colors"
            >
              {`すべて表示（${indexArticles.length}）`}
            </button>
          )}
        </div>
        <div id="toc-article-list" class="space-y-1">
          {indexArticles.map((entry, i) => {
            const outside = Math.abs(i - currentIndex) > INDEX_WINDOW;
            return (
              <a
                href={entry.href}
                data-toc-link
                aria-current={entry.isCurrent ? 'page' : undefined}
                data-toc-outside={outside ? 'true' : undefined}
                class={`flex items-start space-x-3 p-2 transition-colors group ${
                  outside ? 'hidden ' : ''
                }${entry.isCurrent ? 'bg-[#6f4229]/10' : 'hover:bg-[#6f4229]/10'}`}
              >
                <span class={`w-1.5 h-1.5 shrink-0 mt-2 ${entry.isCurrent ? 'bg-[#6f4229]' : 'bg-[#8b593e]'}`}></span>
                <div>
                  <div class="font-sans text-[11px] uppercase tracking-wider text-[#8b593e] font-semibold">
                    {L.tocNoPrefix} {entry.number}
                    {entry.date && <span class="text-[#84746c]"> — {entry.date}</span>}
                  </div>
                  <div class={`font-serif text-sm font-medium transition-colors ${
                    entry.isCurrent ? 'text-[#6f4229]' : 'text-[#1b1c1a] group-hover:text-[#6f4229]'
                  }`}>
                    {entry.title}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      {/* 現在記事内のセクション */}
      {tocEntries.length > 0 && (
        <div class="pt-2 border-t border-[#8b593e]/20 space-y-1">
          <div class="text-[10px] font-sans uppercase tracking-[0.2em] text-[#6f4229] font-bold mb-2 mt-3">
            {L.tocInThisArticle}
          </div>
          {tocEntries.map((entry, i) => (
            <a href={`#${entry.id}`} data-toc-link class="flex items-start space-x-3 p-2 hover:bg-[#6f4229]/10 transition-colors group">
              <span class="w-1.5 h-1.5 bg-[#d6c3ba] shrink-0 mt-2"></span>
              <div>
                <div class="font-sans text-[11px] uppercase tracking-wider text-[#8b593e] font-semibold">
                  {L.tocSectionPrefix} {String(i + 1).padStart(2, '0')}
                </div>
                <div class="font-serif text-sm font-medium text-[#1b1c1a] group-hover:text-[#6f4229] transition-colors">
                  {entry.text}
                </div>
              </div>
            </a>
          ))}
        </div>
      )}

      {hasKaruta && (
        <div class="pt-2 border-t border-[#8b593e]/20 space-y-1">
          <a href="#section-karuta" data-toc-link class="flex items-center space-x-3 p-2 hover:bg-[#6f4229]/10 transition-colors text-xs font-sans uppercase tracking-wider text-[#51443d] hover:text-[#1b1c1a] font-medium">
            <span class="material-symbols-outlined text-[16px] text-[#6f4229]">style</span>
            <span class="font-medium text-[#1b1c1a]">{L.tocKarutaLabel}</span>
          </a>
        </div>
      )}

      <div class="pt-4 text-[10px] text-[#84746c] font-sans tracking-widest uppercase border-t border-[#d6c3ba]/30 mt-3">
        {L.tocFooter}
      </div>
    </div>
  </section>

  {/* Article Body Content — App.tsx L533-673 */}
  <article class="max-w-4xl mx-auto w-full px-6 md:px-12 lg:px-0 space-y-16">
    {/* 本文ブロック（karutaGrid は下の Card Folio で描画するためここでは除外） */}
    {contentSections.map((section: any, sectionIndex: number) => {
      if (!section) return null;
      if (section._template === 'imageGrid') {
        return <ImageGrid images={section.images ?? []} />;
      }
      if (section._template === 'karutaGrid') return null;

      const ids = (tocIdsBySection.get(sectionIndex) ?? []) as string[];
      const sectionHeading = tocEntries.find(
        (e) => e.sectionIndex === sectionIndex && e.level === 2,
      );

      return (
        <section id={sectionHeading?.id} class="scroll-mt-28 space-y-6 pt-4">
          {sectionHeading && (
            <div class="space-y-1.5 border-b border-[#d6c3ba]/40 pb-3.5">
              <span class="font-sans text-xs uppercase tracking-[0.2em] text-[#865138] font-semibold">
                SECTION {String(tocEntries.indexOf(sectionHeading) + 1).padStart(2, '0')}
              </span>
              <h2 class="font-serif text-2xl sm:text-3xl text-[#1b1c1a] font-normal leading-snug">
                {sectionHeading.text}
              </h2>
            </div>
          )}
          <div
            class="article-body space-y-5 font-serif text-base sm:text-lg text-[#1b1c1a] leading-relaxed"
            set:html={addHeadingIds(richTextToHtml(section.bodyText), ids)}
          />
        </section>
      );
    })}

    {/* Card Folio: 記事固有の karutaGrid を優先し、無ければ全記事共通 karuta.json を出力 */}
    <KarutaGrid title={karutaTitle} cards={karutaCards} />

    {/* Connected Articles Navigation — App.tsx L781-849 */}
    {(prev || next) && (
      <nav aria-label="Article Pagination" class="pt-8 pb-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {prev ? (
            <a href={prev.href} class="bg-[#f6f3f0] p-6 flex flex-col justify-between group hover:bg-[#f0edea] transition-colors border border-[#d6c3ba]/40">
              <div class="space-y-2">
                <span class="font-sans text-[11px] uppercase tracking-widest text-[#84746c] group-hover:text-[#6f4229] transition-colors flex items-center gap-1 font-semibold">
                  <span class="material-symbols-outlined text-[14px]">arrow_back</span>
                  {L.prevLabel}
                </span>
                <h3 class="font-serif text-lg text-[#1b1c1a] group-hover:text-[#6f4229] transition-colors">
                  {prev.title}
                </h3>
              </div>
            </a>
          ) : (
            <div class="bg-[#f6f3f0] p-6 border border-[#d6c3ba]/40 opacity-40"></div>
          )}

          {next && (
            <a href={next.href} class="bg-[#f6f3f0] p-6 flex flex-col justify-between group hover:bg-[#f0edea] transition-colors border border-[#d6c3ba]/40 text-left md:text-right">
              <div class="space-y-2">
                <div class="flex items-center justify-start md:justify-end gap-1">
                  <span class="font-sans text-[11px] uppercase tracking-widest text-[#84746c] group-hover:text-[#6f4229] transition-colors flex items-center gap-1 font-semibold">
                    {L.nextLabel}
                    <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                  </span>
                </div>
                <h3 class="font-serif text-lg text-[#1b1c1a] group-hover:text-[#6f4229] transition-colors">
                  {next.title}
                </h3>
              </div>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BlogPost>

<style>
  /* 本文組版（mablogx の article body に相当） */
  .article-body p {
    margin-bottom: 0;
  }
  .article-body p:first-child::first-letter {
    font-family: 'Noto Serif', 'Noto Serif JP', serif;
    font-size: 3rem;
    line-height: 1;
    float: left;
    margin-right: 0.75rem;
    color: #6f4229;
  }
  .article-body h2,
  .article-body h3 {
    font-weight: 400;
    color: #1b1c1a;
    line-height: 1.3;
  }
  .article-body h2 {
    font-size: 1.5rem;
  }
  .article-body h3 {
    font-size: 1.25rem;
  }
  .bear-prose strong,
  .bear-prose b {
    color: #1b1c1a;
  }
  /* Index: 「すべて表示」で全件をスクロールさせる（50記事でも破綻しない） */
  #toc-article-list {
    scrollbar-width: thin;
  }
  #toc-article-list.is-full {
    max-height: min(58vh, 520px);
    overflow-y: auto;
    padding-right: 4px;
  }
</style>

<script>
  // --- Index (Frosted Glass TOC) ---
  const tocBtn = document.getElementById('toc-trigger-btn');
  const tocDrawer = document.getElementById('toc-drawer');
  const tocClose = document.getElementById('toc-close-btn');

  const closeToc = () => tocDrawer?.classList.add('hidden');
  tocBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    tocDrawer?.classList.toggle('hidden');
  });
  tocClose?.addEventListener('click', closeToc);
  document.querySelectorAll('[data-toc-link]').forEach((link) => {
    link.addEventListener('click', closeToc);
  });
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (tocDrawer && !tocDrawer.classList.contains('hidden') && !target.closest('#toc-container')) {
      closeToc();
    }
  });

  // --- Index: 前後5件表示 ⇄ 全件スクロール ---
  const modeBtn = document.getElementById('toc-mode-btn');
  const articleList = document.getElementById('toc-article-list');
  const modeLabel = modeBtn?.querySelector('[data-toc-mode-label]');
  const fullLabel = modeBtn?.getAttribute('data-full-label') || '';
  const windowLabel = modeBtn?.getAttribute('data-window-label') || '';
  let fullMode = false;
  modeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    fullMode = !fullMode;
    articleList?.classList.toggle('is-full', fullMode);
    articleList?.querySelectorAll('[data-toc-outside]').forEach((el) => {
      el.classList.toggle('hidden', !fullMode);
    });
    if (modeLabel) modeLabel.textContent = fullMode ? windowLabel : fullLabel;
  });

  // --- 日本語ドロワー ---
  const langBtn = document.getElementById('lang-trigger-btn');
  const langDrawer = document.getElementById('lang-drawer');
  const langChevron = document.getElementById('lang-chevron');
  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const hidden = langDrawer?.classList.toggle('hidden');
    if (langChevron) {
      langChevron.style.transform = hidden ? 'rotate(0deg)' : 'rotate(180deg)';
    }
  });

  // --- Toast ---
  const showToast = (msg: string) => {
    const el = document.getElementById('ma-toast');
    if (!el) return;
    el.querySelector('span:last-child')!.textContent = msg;
    el.classList.remove('hidden');
    window.setTimeout(() => el.classList.add('hidden'), 3000);
  };

  // --- Bookmark ---
  const bookmarkBtn = document.querySelector('[data-bookmark]');
  let bookmarked = false;
  bookmarkBtn?.addEventListener('click', () => {
    bookmarked = !bookmarked;
    const icon = bookmarkBtn.querySelector('span');
    if (icon) icon.textContent = bookmarked ? 'bookmark' : 'bookmark_border';
    bookmarkBtn.classList.toggle('text-[#6f4229]', bookmarked);
    showToast(bookmarked ? 'Article bookmarked (保存しました)' : 'Bookmark removed');
  });

  // --- Share ---
  const shareBtn = document.querySelector('[data-share]');
  shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    const nav = navigator as any;
    if (nav.share) {
      try {
        await nav.share({ title: document.title, url });
      } catch {
        /* cancelled */
      }
    } else {
      await nav.clipboard?.writeText(url);
      showToast('Link copied to clipboard (クリップボードにコピーしました)');
    }
  });
</script>
