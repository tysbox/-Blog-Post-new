---
// ブログ一覧 — mablogx otideマ insistence の編集デザインに統一
// （記事ページと同じ fixed header / editorial footer を使う）
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { stripMarkdown } from '../../utils/richText';
import { permalinkOf } from '../../utils/postOrder';
import config from '../../content/config/config.json';
import { timestamp, formatYear } from '../../utils/date';

const posts = (await getCollection('blog')).sort(
  (a, b) => timestamp(b.data.pubDate) - timestamp(a.data.pubDate),
);

const [lead, ...rest] = posts;

const readMinutes = (p: (typeof posts)[number]) => {
  const chars = (p.data.description || '').replace(/\s+/g, '').length;
  return Math.max(1, Math.round(chars / 700));
};
---

<BlogPost title={config.seo?.title || '間 MA (Vide Signifiant)'} description={config.seo?.description}>
  <section class="max-w-4xl mx-auto w-full px-6 md:px-12 lg:px-0 pt-8 pb-6">
    <div class="space-y-1.5 border-b border-[#d6c3ba]/40 pb-4">
      <span class="font-sans text-xs uppercase tracking-[0.2em] text-[#865138] font-semibold">Journal</span>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#1b1c1a] font-normal tracking-tight leading-[1.15]">
        {config.archive?.title || '間 MA — Vide Signifiant'}
      </h1>
      {config.archive?.description && (
        <p class="font-serif text-sm italic text-[#51443d] pt-1">
          {config.archive.description}
        </p>
      )}
    </div>
  </section>

  <article class="max-w-4xl mx-auto w-full px-6 md:px-12 lg:px-0 space-y-16">
    {/* Lead article */}
    {lead && (
      <section class="scroll-mt-28 space-y-6 pt-4">
        <a href={`/blog/${permalinkOf(lead.id)}`} class="block group">
          <div class="w-full relative bg-[#f6f3f0] overflow-hidden mb-6">
            <div class="w-full h-[300px] sm:h-[420px] overflow-hidden">
              {lead.data.heroImage && (
                <img
                  src={lead.data.heroImage}
                  alt={stripMarkdown(lead.data.title)}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              )}
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
          </div>
          <div class="space-y-1.5 border-b border-[#d6c3ba]/40 pb-3.5">
            <span class="font-sans text-xs uppercase tracking-[0.2em] text-[#865138] font-semibold">
              Latest Essay
            </span>
            <h2 class="font-serif text-2xl sm:text-3xl text-[#1b1c1a] font-normal leading-snug group-hover:text-[#6f4229] transition-colors">
              {stripMarkdown(lead.data.title)}
            </h2>
          </div>
          {lead.data.description && (
            <p class="font-serif text-base sm:text-lg text-[#1b1c1a] leading-relaxed mt-4 line-clamp-3">
              {stripMarkdown(lead.data.description)}
            </p>
          )}
        </a>
      </section>
    )}

    {/* Archive grid */}
    {rest.length > 0 && (
      <section class="pt-8 border-t border-[#d6c3ba]/40 space-y-10">
        <div class="flex items-baseline justify-between pb-3 border-b border-[#d6c3ba]/40">
          <h2 class="font-serif text-2xl text-[#1b1c1a] font-normal">Archive</h2>
          <span class="text-[11px] font-sans uppercase tracking-widest text-[#84746c]">
            {String(rest.length).padStart(2, '0')} Entries
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {rest.map((post) => (
            <a href={`/blog/${permalinkOf(post.id)}`} class="group flex flex-col">
              <div class="aspect-[3/2] w-full bg-[#f0edea] overflow-hidden shadow-sm relative">
                {post.data.heroImage && (
                  <img
                    src={post.data.heroImage}
                    alt={stripMarkdown(post.data.title)}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                )}
              </div>
              <div class="flex flex-col space-y-1 pt-4">
                <div class="flex items-center gap-2 text-[10px] font-sans uppercase tracking-[0.2em] text-[#865138]">
                  <span>{formatYear(post.data.pubDate)}</span>
                  <span class="text-[#d6c3ba]">•</span>
                  <span>{readMinutes(post)} min read</span>
                </div>
                <h3 class="font-serif text-lg text-[#1b1c1a] group-hover:text-[#6f4229] transition-colors leading-snug">
                  {stripMarkdown(post.data.title)}
                </h3>
                {post.data.description && (
                  <span class="font-serif text-xs text-[#51443d] leading-relaxed line-clamp-2">
                    {stripMarkdown(post.data.description)}
                  </span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BlogPost>
