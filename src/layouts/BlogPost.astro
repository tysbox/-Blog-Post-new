---
// 記事レイアウト — /tmp/mablogx/src/App.tsx / ArticleMa.astro 100% 準拠
// 固定ヘッダー + 記事本文 + Editorial Footer。
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CloudflareBeacon from '../components/CloudflareBeacon.astro';
import { getEntry, getCollection } from 'astro:content';
import config from '../content/config/config.json';
import { timestamp } from '../utils/date';
import { permalinkOf } from '../utils/postOrder';

type Props = CollectionEntry<'blog'>['data'];

const { title, description } = Astro.props;

const globalConfig = await getEntry('global', 'config');
const siteTitle = globalConfig?.data?.siteTitle || '間　MA (Vide Signifiant)';
// ヘッダー／フッターは全ページ共通のため、補助設定は使用しない。
// ナビ／SNSリンクは Keystatic「SEO / ナビゲーション設定」から読む。
const footerText =
  globalConfig?.data?.footerText || '© 2025 The Way of Aesthetics. All rights reserved.';
const navLinks = (config?.navLinks ?? []).filter((l) => l?.label && l?.href);
const links = (config?.socialLinks ?? []).filter((l) => l?.label);

// Latest Writing = 最新の記事へ
const allPosts = await getCollection('blog');
const latestUrl = (() => {
  const sorted = [...allPosts].sort(
    (a, b) =>
      timestamp(b.data.updatedDate, b.data.pubDate) -
      timestamp(a.data.updatedDate, a.data.pubDate),
  );
  return sorted[0] ? `/blog/${permalinkOf(sorted[0].id)}` : '/';
})();

// /latest は「最新の記事」そのものを指すため、実際のURLに解決する。
const resolveHref = (href: string) => (href === '/latest' ? latestUrl : href);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;1,400&family=Noto+Serif+JP:wght@400;700&family=Manrope:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0" rel="stylesheet" />
  </head>

  <body class="min-h-screen bg-[#F8F5F2] font-serif text-gray-700 selection:bg-[#8B593E]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Toast Notification — App.tsx L65-70 */}
    <div
      id="ma-toast"
      class="hidden fixed bottom-6 right-6 z-50 bg-[#30302e] text-[#fcf9f5] px-5 py-3 text-xs tracking-wider uppercase font-sans shadow-lg border border-[#84746c]/40 animate-fade-in flex items-center gap-2"
    >
      <span class="material-symbols-outlined text-[16px] text-[#f8b897]">check_circle</span>
      <span></span>
    </div>
    {/* Header — ポータルと共通（タイトルは全ページ黒） */}
    <header class="flex justify-between items-center py-6 border-b border-gray-200">
      <div class="flex items-center gap-6">
        <h1 class="text-2xl font-bold text-gray-900">
          <a href="/" class="hover:text-[#A36A4F] transition-colors">{siteTitle}</a>
        </h1>
      </div>
      <nav class="hidden md:flex items-center space-x-8 text-sm font-medium">
        {navLinks.map((link: any, i: number) => (
          <a
            href={resolveHref(link.href)}
            class={i === 0 ? 'text-[#A36A4F] font-semibold transition-colors' : 'text-gray-600 hover:text-[#A36A4F] transition-colors'}
          >
            {link.label}
          </a>
        ))}
      </nav>
      <div class="flex items-center space-x-3 sm:space-x-4">
        <a
          href="https://bisen-kyoto.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="block w-[95px] sm:w-[105px] h-[50px] sm:h-[60px] flex items-center justify-center transition-transform hover:scale-105"
        >
          <img src="/images/Logo1.png" alt="BiScène" class="w-[95px] sm:w-[105px] h-[50px] sm:h-[60px] object-contain" width="105" height="60" />
        </a>
      </div>
    </header>

    <main class="w-full py-8 sm:py-12 md:py-16">
      <slot />
    </main>
    </div>

    {/* ブログページ フッター上ブロック（5）:
        Colophon & Contact を削除し、Journal Sections を右端へ移設。
        Privacy & Terms / Kyoto, Japan は About & Contact の下へ。 */}
    <footer class="w-full bg-[#f6f3f0] border-t border-[#d6c3ba]/40">
      <div class="w-full px-6 md:px-12 lg:px-20 py-14">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-baseline">
          <div class="md:col-span-5 space-y-3">
            <div class="flex items-baseline space-x-2">
              <span class="font-serif text-2xl text-[#1b1c1a]">間 MA</span>
              <span class="font-serif text-sm text-[#51443d] italic">(Vide Signifiant)</span>
            </div>
            <p class="font-serif text-xs text-[#51443d] max-w-sm leading-relaxed">
              A contemplative editorial journal exploring the interval, spatial negative space,
              Japanese aesthetics, and contemporary thought in Kyoto.
            </p>
          </div>

          {/* Journal Sections を右端（Colophon & Contact の跡地）へ移設 */}
          <div class="md:col-span-7 space-y-4 md:text-right">
            <div>
              <div class="font-sans text-xs uppercase tracking-widest text-[#865138] font-semibold mb-3">Journal Sections</div>
              <ul class="space-y-1.5 font-serif text-xs">
                <li>
                  <a href="/" class="text-[#51443d] hover:text-[#1b1c1a] transition-colors">Back to Main Page</a>
                </li>
                <li>
                  <a href="/about" class="text-[#51443d] hover:text-[#6f4229] transition-colors">About &amp; Contact</a>
                </li>
              </ul>
            </div>
            <div class="flex items-center gap-6 text-[11px] font-sans uppercase tracking-widest text-[#84746c] md:justify-end">
              <a href="/" class="hover:text-[#1b1c1a] transition-colors">Privacy &amp; Terms</a>
              <span>Kyoto, Japan</span>
            </div>
          </div>
        </div>
      </div>
    </footer>

    {/* 共通フッター（ポータルの Footer.astro と同一） */}
    <footer class="py-8 px-4 border-t border-gray-200 mt-10">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-500 font-serif">
        <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-6">
          <span class="font-bold text-gray-900">{siteTitle}</span>
          <span>{footerText}</span>
        </div>
        <nav class="flex gap-6">
          {links.map((l: any) => (
            <a class="hover:text-gray-900 transition-colors" href={(l.url || l.href) ?? '#'}>
              {l.label || l.platform}
            </a>
          ))}
        </nav>
      </div>
    </footer>
    <CloudflareBeacon />
  </body>
</html>
