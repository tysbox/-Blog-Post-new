---
const { title, heroImage, description } = Astro.props;
import CloudflareBeacon from '../components/CloudflareBeacon.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700&display=swap" rel="stylesheet" />
    <style>
      :root { --neutral-900: #111827; --accent: #A36A4F; }
      html { font-family: 'Noto Serif JP', serif; }
      body { background: #F8F5F2; color: var(--neutral-900); line-height: 1.6; margin: 0; }
      a { color: var(--accent); text-decoration: none; }
      .hero-content h1 { font-size: calc(1.5rem + 3vw); margin: 0; }
    </style>
  </head>
  <body>
    {/** Hero (incremental restore) */}
      {heroImage && (
        <div class="hero-overlay">
          <img src={heroImage} alt={title} />
          <div class="hero-content">
            <h1>{title}</h1>
            {description && <p>{description}</p>}
          </div>
        </div>
      )}

    <slot />
    <CloudflareBeacon />
  </body>
</html>
