---
import siteSettings from '../content/settings/site.json';
import Footer from '../components/Footer.astro';
import CloudflareBeacon from '../components/CloudflareBeacon.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>{title}</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet"/>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-family: "Noto Serif JP", serif;
    }

    body {
      background-color: #F8F5F2;
      color: #374151;
      line-height: 1.6;
    }

    h1, h2, h3, h4, h5, h6 {
      font-weight: 700;
      margin-top: 1.5em;
      margin-bottom: 0.5em;
    }

    h1 { font-size: 2.25rem; }
    h2 { font-size: 1.875rem; }
    h3 { font-size: 1.5rem; }

    a {
      color: #A36A4F;
      text-decoration: none;
      transition: opacity 0.3s;
    }

    a:hover {
      opacity: 0.8;
    }

    p {
      margin-bottom: 1em;
      line-height: 1.8;
    }

    ul, ol {
      margin-left: 1.5em;
      margin-bottom: 1em;
    }

    li {
      margin-bottom: 0.5em;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 2rem;
      background-color: #F8F5F2;
      border-bottom: 1px solid #E5E7EB;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .logo-text {
      font-size: 1.125rem;
      font-weight: bold;
      color: #111827;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .logo-text span {
      font-size: 1.5rem;
    }

    .header-nav {
      display: none;
      gap: 2rem;
    }

    @media (min-width: 768px) {
      .header-nav {
        display: flex;
      }
    }

    .header-nav a {
      color: #6B7280;
      font-size: 0.875rem;
      font-weight: 500;
    }

    .header-nav a.active {
      color: #111827;
      font-weight: 700;
    }

    .login-btn {
      background-color: #D1D5DB;
      color: #374151;
      padding: 0.5rem 1rem;
      border-radius: 0.375rem;
      font-size: 0.875rem;
      font-weight: 500;
      display: none;
      text-decoration: none;
      transition: opacity 0.3s;
    }

    @media (min-width: 768px) {
      .login-btn {
        display: inline-block;
      }
    }

    .login-btn:hover {
      opacity: 0.8;
    }

    .container {
      max-width: 80rem;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .hero {
      background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.5)), 
                  url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><rect fill="%23000" width="1200" height="400"/><text x="50%" y="50%" font-size="48" fill="white" text-anchor="middle" dominant-baseline="middle">Kodo: Listening to Fragrance</text><text x="50%" y="60%" font-size="18" fill="white" text-anchor="middle" dominant-baseline="middle">Engaging the spirit through the refined and subtle art of incense.</text></svg>');
      background-size: cover;
      background-position: center;
      color: white;
      padding: 6rem 2rem;
      text-align: center;
      border-radius: 0.75rem;
      margin: 2rem 0;
    }

    .hero h1 {
      font-size: 3rem;
      margin: 0 0 0.5em 0;
      color: white;
    }

    .hero p {
      font-size: 1.125rem;
      margin: 0;
      color: #E5E7EB;
    }

    .section-title {
      text-align: center;
      font-size: 2rem;
      font-weight: bold;
      color: #111827;
      margin: 3rem 0 2rem 0;
    }

    .grid {
      display: grid;
      gap: 2rem;
      margin: 2rem 0;
    }

    @media (min-width: 768px) {
      .grid-2 {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .grid-3 {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .article-card {
      background-color: white;
      border-radius: 0.5rem;
      overflow: hidden;
      border: 1px solid #E5E7EB;
      transition: box-shadow 0.3s;
    }

    .article-card:hover {
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .article-image {
      width: 100%;
      height: 12rem;
      object-fit: cover;
      display: block;
    }

    .article-content {
      padding: 1.5rem;
    }

    .article-category {
      font-size: 0.75rem;
      font-weight: bold;
      color: #A36A4F;
      margin-bottom: 0.5rem;
    }

    .article-title {
      font-size: 1.25rem;
      font-weight: bold;
      color: #111827;
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    .article-description {
      color: #6B7280;
      font-size: 0.875rem;
      line-height: 1.6;
      margin-bottom: 1rem;
    }

    .article-link {
      color: #A36A4F;
      font-weight: bold;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
    }

    .footer {
      border-top: 1px solid #E5E7EB;
      margin-top: 3rem;
      padding: 2rem 1rem;
      background-color: #FAFAF8;
      text-align: center;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 2rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: #6B7280;
      font-size: 0.875rem;
      font-weight: 500;
    }

    .footer-copyright {
      color: #9CA3AF;
      font-size: 0.875rem;
    }

    .main {
      padding: 2rem 0;
    }
  </style>
</head>
<body>
  <div style="display: flex; min-height: 100vh; flex-direction: column;">
    <header class="header">
      <div class="header-left">
        <a href="/" class="logo-text">
          <span>道</span>
          <span>The Way</span>
        </a>
      </div>
      <nav class="header-nav">
        <a href="/about">About</a>
        <a href="#">Contact</a>
        <a href="/">Latest Writing</a>
      </nav>
      <a href="#" class="login-btn">Login</a>
    </header>

    <main class="main" style="flex-grow: 1;">
      <div class="container">
        <slot />
      </div>
    </main>

    <Footer />
  </div>
  <CloudflareBeacon />
</body>
</html>
