{
  "name": "my-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@9",
  "scripts": {
    "check:node-version": "node ./scripts/check-node-version.mjs",
    "deps:check": "bash ./scripts/check-node-modules-duplicates.sh",
    "deps:externalize": "bash ./scripts/externalize-node-modules.sh",
    "deps:localize": "bash ./scripts/externalize-node-modules.sh --restore",
    "backup:icloud": "bash ./scripts/sync-icloud-backup.sh",
    "preinstall": "node ./scripts/check-node-version.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "dev:keystatic": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "edit": "bash ./scripts/start-editing.sh",
    "images:convert": "node scripts/convert-images.cjs",
    "clean:caches": "rm -rf node_modules/.vite",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "dev:astro": "astro dev"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.3.5",
    "marked": "5.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "prettier": "3.7.4"
  }
}
