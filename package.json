{
  "name": "my-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@9",
  "scripts": {
    "check:node-version": "node ./scripts/check-node-version.mjs",
    "deps:check": "bash ./scripts/check-node-modules-duplicates.sh",
    "deps:externalize": "bash ./scripts/externalize-node-modules.sh",
    "deps:localize": "bash ./scripts/externalize-node-modules.sh --restore",
    "backup:icloud": "bash ./scripts/sync-icloud-backup.sh",
    "preinstall": "node ./scripts/check-node-version.mjs",
    "tina:serve": "PATH=\"$PWD/node_modules/.bin:$PATH\" TINA_DEV_PORT=7788 TINA_GRAPHQL_PORT=9001 NODE_OPTIONS='--dns-result-order=ipv4first' tinacms dev --port 7777 -c \"astro dev\"",
    "dev": "npm run tina:serve",
    "tina:dev": "bash ./scripts/start-tina-dev.sh",
    "images:convert": "node scripts/convert-images.cjs",
    "dev:alternate": "bash ./scripts/start-tina-dev.sh",
    "clean:caches": "rm -rf node_modules/.vite node_modules/@tinacms/app/node_modules/.vite",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/mdx": "4.3.14",
    "@astrojs/react": "4.4.2",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.2",
    "@astrojs/tailwind": "6.0.2",
    "astro": "5.18.1",
    "marked": "5.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.5.0",
    "tailwindcss": "3.4.19",
    "tinacms": "2.10.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@tinacms/cli": "2.0.5",
    "@types/node": "22.18.12",
    "prettier": "3.7.4"
  }
}
