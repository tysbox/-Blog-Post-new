# build output
dist/
admin/
public/admin/
# generated types
.astro/

# dependencies
node_modules/
# Keystatic の dev サーバーはプロジェクト全体を再帰走査する
# (collectEntriesInDir は .gitignore を尊重するが、名前は完全一致で
#  'node_modules' のみ除外するため 'node_modules.old' は走査される)。
# 未除外だと 1.6GB を走査して /api/keystatic/tree が応答しなくなるため除外する。
node_modules.old/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# local backups and editor files
*.bak
*.code-workspace
scripts/webp-backup-*/

# スプレッドシート型エディタ (npm run sheet) の保存前バックアップ
.sheet-backups/

# ローカルのみ / コミット対象外
# backup/ は Tina 移行時の退避データ（移行元の原本 JSON を含む）。
# .vscode/ はエディタ個別の設定。
.vscode/
backup/

# jetbrains setting folder
.idea/
.env*.local
node_modules
# iCloud 同期の重複コピー（"name 2" / "name 2.sh" 等）はコミット対象外
* 2
* 2.*
